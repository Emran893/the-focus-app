<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a0000"
    android:clipChildren="false">

    <!-- F. lettermark — shows first -->
    <ImageView
        android:id="@+id/splash_logo_f"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:src="@drawable/splash_logo_f"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:adjustViewBounds="true" />

    <!-- The Focus — full text, reveals second -->
    <ImageView
        android:id="@+id/splash_logo_full"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:src="@drawable/splash_logo_full"
        android:scaleType="fitCenter"
        android:alpha="0"
        android:adjustViewBounds="true" />

</FrameLayout>
